rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidListing(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.price is number && data.price >= 0
        && data.categoryId is string
        && data.sellerId is string
        && data.phone is string;
    }

    // Listings: readable by everyone, writable with valid payload
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isValidListing(request.resource.data);
      allow update: if true;
      allow delete: if true;
    }

    // Users: registration & profile management
    match /users/{userId} {
      allow read, write: if true;
    }

    // System connection test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
